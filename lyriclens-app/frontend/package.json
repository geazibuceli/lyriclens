{
  "name": "lyriclens-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "build": "tsc -b && vite build",
    "test:studio": "node tests/lyrics-alignment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts tsconfig.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json index.html"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "axe-core": "4.10.3",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  }
}
