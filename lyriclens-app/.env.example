# Copy values into your shell or use uvicorn --env-file after installing python-dotenv.
LYRICLENS_DATA=data
LYRICLENS_MODEL=Systran/faster-whisper-small
LYRICLENS_REVISION=2ec96c5472da50d38d40c0cfe0602af2e94b4c8a
LYRICLENS_DEVICE=cpu
LYRICLENS_COMPUTE=int8
LYRICLENS_SEPARATION_DEVICE=cpu
LYRICLENS_MAX_SECONDS=600
LYRICLENS_MAX_BYTES=157286400
LYRICLENS_QUEUE_SIZE=8
LYRICLENS_DECODE_TIMEOUT=30
LYRICLENS_SEPARATION_TIMEOUT=600
LYRICLENS_FFMPEG=ffmpeg
# Native frontend proxy; native backend port is selected by uvicorn or run-backend.ps1.
LYRICLENS_API_URL=http://127.0.0.1:8011
# Docker host ports (container backend still listens on 8000).
LYRICLENS_BACKEND_PORT=8012
LYRICLENS_FRONTEND_PORT=5182
# Docker build features. Keep these enabled across rebuilds if you use them.
LYRICLENS_WITH_SEPARATION=false
LYRICLENS_WITH_TRANSLATION=false
